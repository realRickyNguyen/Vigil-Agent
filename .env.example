# Meterless Nightshift is the required primary provider (19 Oct guide). Values come from Nightshift's Console, top right.
# Example only; copy the URL shown in the Console. With Docker, localhost and 127.0.0.1 become host.docker.internal.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=meterless/auto
# The NVIDIA key goes in Nightshift's Providers tab, NOT in this file.
# smoke_test.py reads these three; point them at Meterless (or at NVIDIA direct for a quick test only).
MODEL_BASE_URL=http://127.0.0.1:8088/v1
MODEL_API_KEY=your-nightshift-runtime-token
NEMOTRON_MODEL=meterless/auto
# Vigil app settings (defaults shown). Nightshift identifies the app by METERLESS_APP.
METERLESS_APP=vigil
ANALYST_MODEL=nvidia/nemotron-3-ultra-550b-a55b
REVIEWER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Whole-call limit; streamed replies (MODEL_STREAM) avoid Nightshift's 45 s cut on buffered calls
MODEL_TIMEOUT_SECONDS=90
MODEL_STREAM=true
REVIEWER_ROUNDS=1
MODEL_PARALLEL=4
# Wall-clock budget per run; the revision round and Skeptic are skipped when too little is left
RUN_BUDGET_SECONDS=600
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=your-key-here
ZETARIS_ORG_ID=1
SOURCE_TIMEOUT_SECONDS=20
MAX_RETRIES=1
SAMPLE_MODE=false
LOG_LEVEL=INFO
PORT=8000
# World Model engine state, kept across runs (default state/world-model.json)
WORLD_MODEL_PATH=state/world-model.json
# Analyst: strongest rows by chi2 always assessed, plus up to ANALYST_EXTRA chosen by the model
ANALYST_TOP=15
ANALYST_EXTRA=5
# Skeptic: review_next items checked against co-reported drugs, and co-drugs per item (4 openFDA calls each)
SKEPTIC_ITEMS=3
SKEPTIC_CO_DRUGS=3
